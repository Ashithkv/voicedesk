# VAPI.ai — create an assistant at https://dashboard.vapi.ai
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
# Optional: if you enable signature verification on the Server URL
VAPI_WEBHOOK_SECRET=

# OpenAI — used for intent classification + response generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Twilio — only required if you're bringing your own phone number
# into VAPI rather than using a free VAPI-provided number
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Database
DATABASE_URL=sqlite:///./voicedesk.db

ENV=development
